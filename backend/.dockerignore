# Keep the build context small and keep secrets out of it. The image installs
# dependencies only; app/ arrives via a bind mount at run time.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Secrets reach the container through env_file at run time, never via COPY.
.env
.env.*

.pytest_cache/
.mypy_cache/
.ruff_cache/
